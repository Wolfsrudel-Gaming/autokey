<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ist in Windows 10 (ab 1903) und Windows 11 bereits enthalten:
         die fertige AutoKey.exe läuft ohne Installation zusätzlicher Laufzeitumgebungen. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AutoKey</RootNamespace>
    <AssemblyName>AutoKey</AssemblyName>
    <ApplicationIcon>AutoKey.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Version>1.2.0</Version>
    <Product>AutoKey</Product>
    <AssemblyTitle>AutoKey</AssemblyTitle>
    <Company>Wolfsrudel Gaming</Company>
    <Description>Drückt automatisch Tasten und Maustasten – aufgezeichnet oder als Ablauf, nach Zeitplan oder dauerhaft gehalten.</Description>
    <Copyright>© 2026 Wolfsrudel Gaming</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Erlaubt das Bauen für .NET Framework auch ohne installiertes Targeting Pack (z. B. unter Linux / in CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AutoKey.ico" LogicalName="AutoKey.ico" />
  </ItemGroup>

</Project>
